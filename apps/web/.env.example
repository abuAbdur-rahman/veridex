# Base API origin for REST + WebSocket. Leave unset for same-origin (Vite proxy in dev).
# Example: VITE_API_URL=https://api.veridex.example
VITE_API_URL=
# Optional explicit WebSocket origin (wss://...). Falls back to VITE_API_URL with wss.
VITE_WS_URL=
# MCP endpoint URL shown on /profile/mcp. Leave unset to hide the client-config block.
# Falls back to VITE_API_URL + /mcp when VITE_MCP_URL is unset.
VITE_MCP_URL=
