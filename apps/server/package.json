		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1111.0",
		"@fastify/cors": "^11.3.0",
		"@fastify/helmet": "^13.0.2",
		"@fastify/multipart": "^10.1.1",
		"@fastify/rate-limit": "^11.2.0",
		"@fastify/swagger": "^9.8.1",
		"@fastify/swagger-ui": "^6.1.1",
		"better-auth": "^1.6.27",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.6.1",
		"postgres": "^3.4.9",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "^3.2.4",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.20.6",
		"typescript": "^6.0.2",
		"vitest": "^3.2.4"
