HOST=127.0.0.1
PORT=3001
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# Planned MCP connection URL; MCP is not implemented in the current server slice.
PUBLIC_MCP_URL=http://localhost:3001/mcp

# Database
# Local: system PostgreSQL 17+ (no Docker). Create the role + db first:
#   createuser -P veridex   (password: veridex)
#   createdb -O veridex veridex_dev
DATABASE_URL=postgresql://veridex:veridex@localhost:5432/veridex_dev
DATABASE_URL_UNPOOLED=postgresql://veridex:veridex@localhost:5432/veridex_dev

# Production (Neon): pooled for runtime, unpooled for migrations + future pg-boss jobs
# DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.neon.tech/veridex?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<host>.neon.tech/veridex?sslmode=require

# Better Auth
# Drizzle owns the auth and public schema migrations in this repository.
# Create a user with no default fields; onboarding fills optional values later.
BETTER_AUTH_SECRET=replace-with-long-random-string
BETTER_AUTH_URL=http://localhost:3001

# OAuth – leave both values empty to disable a provider; configure both to enable it
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare R2 (S3-compatible) — file storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=veridex-uploads
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# Set to true when running behind a reverse proxy so request IPs honor X-Forwarded-For
TRUST_PROXY=false
