# Production operational env (non-secret, non-3rd-party)
# Secrets/keys NOT included here — keep Neon (DATABASE_URL*), R2 (R2_*), Better Auth
# (BETTER_AUTH_SECRET/BETTER_AUTH_URL), and OAuth (GOOGLE_*/GITHUB_*) in Render
# dashboard only. This file is the filtered, committable subset per request.
# Render injects PORT automatically — do not set it here (see render.yaml + docs).

HOST=0.0.0.0
NODE_ENV=production
TRUST_PROXY=true
WEB_ORIGIN=https://veridex-app.vercel.app
DEV_AUTH_ENABLED=false
